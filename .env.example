# Required: your OpenAI API key (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-...

# Optional: model to use (default gpt-5-mini). Any Chat Completions model works.
# OPENAI_MODEL=gpt-5-mini

# Optional: reasoning effort for reasoning models (default "low" for gpt-5*/o* models; set empty to disable)
# OPENAI_REASONING_EFFORT=low
