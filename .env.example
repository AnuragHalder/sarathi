# Required: your OpenAI API key (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-...

# Optional: the counsellor model and the situation-reader / memory model (both default to gpt-6-luna).
# OPENAI_MODEL=gpt-6-luna
# OPENAI_READER_MODEL=gpt-6-luna

# Login, chat history and memory (Supabase → Project Settings → API). Without these the app runs in guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: reasoning effort (default "low"; set empty to disable). Models that reject it are retried without it.
# OPENAI_REASONING_EFFORT=low

# Eval only: lets scripts/eval.mjs pick the model per request. Never set this in production.
# ALLOW_MODEL_OVERRIDE=1

# Optional: daily message limits enforced on the server (defaults 15 for guests, 60 for signed-in users).
# RATE_LIMIT_GUEST=15
# RATE_LIMIT_USER=60

# Optional: Google Search Console verification code (the content="..." value from its HTML-tag method).
# GOOGLE_SITE_VERIFICATION=

# ---- Morning check-in emails (v3.7). All four are Secrets in Vercel; never add a NEXT_PUBLIC_ prefix.
# Resend (resend.com) API key, after verifying asksarathi.in there.
# RESEND_API_KEY=re_...
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Only the morning job and the unsubscribe link use it.
# SUPABASE_SECRET_KEY=sb_secret_...
# A long random password; Vercel sends it to the morning job so nobody else can trigger it.
# CRON_SECRET=
# Your email: shows the "Send me a test check-in now" button on the "What Sarathi knows" page.
# ADMIN_EMAIL=you@example.com
# Optional: sender (default "Sarathi <sarathi@asksarathi.in>") and site address used in email links.
# CHECKIN_FROM=Sarathi <sarathi@asksarathi.in>
# APP_URL=https://asksarathi.in
