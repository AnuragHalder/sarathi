# Required: your OpenAI API key (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-...

# Optional: the counsellor model (default gpt-5.4-mini) and the cheap situation-reader model (default gpt-5.6-luna).
# Check the exact model names in your OpenAI dashboard.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_READER_MODEL=gpt-5.6-luna

# Optional: reasoning effort (default "low"; set empty to disable). Models that reject it are retried without it.
# OPENAI_REASONING_EFFORT=low

# Eval only: lets scripts/eval.mjs pick the model per request. Never set this in production.
# ALLOW_MODEL_OVERRIDE=1
